# Copy to config-local.yaml and add your credentials
# config-local.yaml is gitignored
#
# New format (recommended): separate copilot and cardpointe credentials
profiles:
  default:
    production: false
    sitename: "cardpointe-uat"
    # merchid is optional; used by gateway commands that take it from config
    # (transaction.inquire, transaction.settlestat, card.bin). Can also be set
    # via the CARDCONNECT_MERCHID env var.
    # merchid: "496474011889"
    copilot:
      username: "your-copilot-username"
      password: "your-copilot-password"
      client_id: "your-client-id"
      client_secret: "your-client-secret"
    cardpointe:
      username: "your-gateway-username"
      password: "your-gateway-password"

# Old format: flat credentials (CoPilot only; add cardpointe_username/cardpointe_password for Gateway)
#  default:
#    sitename: "cardpointe-uat"
#    username: "your-username"
#    password: "your-password"
#    client_id: "your-client-id"
#    client_secret: "your-client-secret"
